    "GraphBaseUrl": "https://graph.facebook.com",
    "GraphApiVersion": "v21.0",
    "PhoneNumberId": "",
    "VerifyToken": "",
    "AppSecret": "",
    "AccessToken": ""
  },
  "Nlu": {
    "BaseUrl": "http://localhost:8000",
    "UseStub": true,
    "MatchThreshold": 0.55
  }
}
