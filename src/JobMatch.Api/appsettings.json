{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SqlServer": "Server=(local)\\sqlexpress;Database=JobMatchGhana;Trusted_Connection=True;TrustServerCertificate=True"
  },
