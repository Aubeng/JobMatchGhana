<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\JobMatch.Infrastructure\JobMatch.Infrastructure.csproj" />
    <ProjectReference Include="..\JobMatch.Domain\JobMatch.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.8">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Dialogue reference data, shared with the NLU service (single source of truth in nlp/data). -->
    <None Include="..\..\nlp\data\taxonomy_v1.json" Link="Data\taxonomy_v1.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\nlp\data\localities_v1.json" Link="Data\localities_v1.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\nlp\data\ghana_districts.json" Link="Data\ghana_districts.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>c2088bef-e1db-41f1-9afa-6bb15422acc4</UserSecretsId>
  </PropertyGroup>

</Project>
